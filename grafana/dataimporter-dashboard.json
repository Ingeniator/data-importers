{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" },
    { "type": "panel", "id": "timeseries", "name": "Time series" },
    { "type": "panel", "id": "stat", "name": "Stat" }
  ],
  "id": null,
  "uid": "dataimporter-overview",
  "title": "dataimporter Overview",
  "description": "Memory health and data import intensity per datasource",
  "tags": ["dataimporter", "prometheus"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(process_resident_memory_bytes{job=\"dataimporter\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "datasource_label",
        "label": "Datasource",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(dataimporter_import_files_total{instance=~\"$instance\"}, datasource)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Import Rate",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "displayName": "files/s",
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(rate(dataimporter_import_files_total{instance=~\"$instance\", status=\"success\"}[$__rate_interval]))",
          "legendFormat": "files/s"
        }
      ]
    },
    {
      "title": "Import Throughput",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(rate(dataimporter_import_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "bytes/s"
        }
      ]
    },
    {
      "title": "Process Memory (RSS)",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 314572800 },
              { "color": "red", "value": 471859200 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(process_resident_memory_bytes{instance=~\"$instance\", job=\"dataimporter\"})",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "title": "Import Failures/s",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(rate(dataimporter_import_files_total{instance=~\"$instance\", status=\"failed\"}[$__rate_interval]))",
          "legendFormat": "failures/s"
        }
      ]
    },
    {
      "title": "Import Intensity",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Files Imported/s by Datasource",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 15, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      },
      "targets": [
        {
          "expr": "sum(rate(dataimporter_import_files_total{instance=~\"$instance\", datasource=~\"$datasource_label\", status=\"success\"}[$__rate_interval])) by (datasource)",
          "legendFormat": "{{ datasource }}"
        }
      ]
    },
    {
      "title": "Bytes Imported/s by Datasource",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1, "fillOpacity": 15, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      },
      "targets": [
        {
          "expr": "sum(rate(dataimporter_import_bytes_total{instance=~\"$instance\", datasource=~\"$datasource_label\"}[$__rate_interval])) by (datasource)",
          "legendFormat": "{{ datasource }}"
        }
      ]
    },
    {
      "title": "Import Duration P50 / P95 by Datasource",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 5 } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(dataimporter_import_seconds_bucket{instance=~\"$instance\", datasource=~\"$datasource_label\"}[$__rate_interval])) by (le, datasource))",
          "legendFormat": "p50 {{ datasource }}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(dataimporter_import_seconds_bucket{instance=~\"$instance\", datasource=~\"$datasource_label\"}[$__rate_interval])) by (le, datasource))",
          "legendFormat": "p95 {{ datasource }}"
        }
      ]
    },
    {
      "title": "Failed Files/s by Datasource",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "color": { "fixedColor": "red", "mode": "fixed" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      },
      "targets": [
        {
          "expr": "sum(rate(dataimporter_import_files_total{instance=~\"$instance\", datasource=~\"$datasource_label\", status=\"failed\"}[$__rate_interval])) by (datasource)",
          "legendFormat": "{{ datasource }}"
        }
      ]
    },
    {
      "title": "Memory",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Process RSS Memory",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 314572800 },
              { "color": "red", "value": 471859200 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(process_resident_memory_bytes{instance=~\"$instance\", job=\"dataimporter\"}) by (instance)",
          "legendFormat": "RSS {{ instance }}"
        },
        {
          "expr": "sum(process_virtual_memory_bytes{instance=~\"$instance\", job=\"dataimporter\"}) by (instance)",
          "legendFormat": "VSZ {{ instance }}"
        }
      ]
    },
    {
      "title": "Memory % of Limit (512 MB)",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.6 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(process_resident_memory_bytes{instance=~\"$instance\", job=\"dataimporter\"}) / 536870912",
          "legendFormat": ""
        }
      ]
    },
    {
      "title": "CPU Usage",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{instance=~\"$instance\", job=\"dataimporter\"}[$__rate_interval])",
          "legendFormat": ""
        }
      ]
    },
    {
      "title": "GC Collections/s by Generation",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 5 } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "rate(python_gc_collections_total{instance=~\"$instance\", job=\"dataimporter\"}[$__rate_interval])",
          "legendFormat": "gen {{ generation }}"
        }
      ]
    },
    {
      "title": "GC Objects Collected/s",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 5 } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "rate(python_gc_objects_collected_total{instance=~\"$instance\", job=\"dataimporter\"}[$__rate_interval])",
          "legendFormat": "gen {{ generation }}"
        }
      ]
    }
  ],
  "schemaVersion": 36
}
